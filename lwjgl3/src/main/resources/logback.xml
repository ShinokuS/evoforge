<configuration>
  <property name="LOG_DIR" value="${evoforge.log.dir:-logs}"/>
  <property name="EVOFORGE_LEVEL" value="${evoforge.log.level:-DEBUG}"/>
  <property name="SESSION_ID" value="${evoforge.session:-unknown}"/>
  <property name="LOG_PATTERN"
            value="%date{STRICT} %-5level [%thread] [%logger{36}] session=${SESSION_ID} scenario=%X{scenario:-none} %kvp{NONE} - %msg%n%ex"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/evoforge.log</file>
    <append>true</append>
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/archive/evoforge.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>200MB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!-- Project categories are verbose in the file by default; third-party libraries stay at INFO. -->
  <logger name="io.github.evoforge" level="${EVOFORGE_LEVEL}"/>
  <logger name="libgdx" level="${EVOFORGE_LEVEL}"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
